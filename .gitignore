# Env files - was previously wrapped in literal quote characters, which
# .gitignore does NOT strip, so this line never actually matched a root
# .env file (only worked for backend/.env because backend/.gitignore also
# covers it separately). Fixed so a root-level .env is actually ignored.
.env
.env.*
!.env.example
